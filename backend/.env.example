# ResolveAI Backend Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=django-insecure-dev-resolveai-biirs-stage1-key-99120
DJANGO_DEBUG=True
ALLOW_DEV_AUTH=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Leave DB_HOST empty to use local development SQLite fallback (db.sqlite3)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=resolveai_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_CONN_MAX_AGE=60

# Security & CORS Origins
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
